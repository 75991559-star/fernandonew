@model Cliente
@{ ViewData["Title"] = "Detalle de cliente"; }
<div class="page-heading"><div><p class="eyebrow">MILIBRERÍA · CLIENTE CLI-@Model.IdeCli.ToString("D4")</p><h1>@Model.NomCli</h1></div><a class="button button-outline" asp-action="List">Volver al listado</a></div><section class="panel detail-panel"><dl><dt>Código de Cliente</dt><dd>CLI-@Model.IdeCli.ToString("D4")</dd><dt>Nombre del Cliente</dt><dd>@Model.NomCli</dd><dt>Distrito</dt><dd>@Model.IdeDis</dd><dt>Número Telefónico</dt><dd>@Model.TelCli</dd><dt>Correo Electrónico</dt><dd>@Model.CorCli</dd><dt>Fecha de Registro</dt><dd>@Model.FreCli?.ToString("dd/MM/yyyy")</dd></dl><div class="form-actions"><a class="button" asp-action="Edit" asp-route-id="@Model.IdeCli">Editar cliente</a><a class="button button-outline" asp-action="List">Cerrar</a></div></section>
