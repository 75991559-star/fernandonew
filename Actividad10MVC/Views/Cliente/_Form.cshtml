@model Cliente
@{ var formAction = (string)ViewData["FormAction"]!; var editando = formAction == "Edit"; }
<section class="panel form-panel"><form asp-action="@formAction" asp-route-id="@Model.IdeCli" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
@if (editando) { <input asp-for="IdeCli" type="hidden" /><div class="field"><label asp-for="IdeCli"></label><input value="CLI-@Model.IdeCli.ToString("D4")" readonly /></div> }
else { <div class="field"><label asp-for="IdeCli"></label><input value="CLI-@((int)ViewBag.CodigoSiguiente).ToString("D4") · automático" readonly /></div> }
<div class="form-grid"><div class="field"><label asp-for="NomCli"></label><input asp-for="NomCli" placeholder="Nombre completo" /><span asp-validation-for="NomCli"></span></div><div class="field"><label asp-for="IdeDis"></label><select asp-for="IdeDis" asp-items="ViewBag.Distritos"><option value="">Selecciona un distrito</option></select><span asp-validation-for="IdeDis"></span></div><div class="field"><label asp-for="TelCli"></label><input asp-for="TelCli" type="tel" placeholder="Número de contacto" /><span asp-validation-for="TelCli"></span></div><div class="field"><label asp-for="CorCli"></label><input asp-for="CorCli" type="email" placeholder="correo@ejemplo.com" /><span asp-validation-for="CorCli"></span></div><div class="field"><label asp-for="FreCli"></label><input asp-for="FreCli" type="date" asp-format="{0:yyyy-MM-dd}" /><span asp-validation-for="FreCli"></span></div></div>
<div class="form-actions"><button class="button" type="submit">@(editando ? "Guardar cambios" : "Registrar cliente")</button><a class="button button-outline" asp-action="List">Cancelar</a></div></form></section>
