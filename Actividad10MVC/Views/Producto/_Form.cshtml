@model Producto
@{ var formAction = (string)ViewData["FormAction"]!; var editando = formAction == "Edit"; }
<section class="panel form-panel"><form asp-action="@formAction" asp-route-id="@Model.IdePro" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
@if (editando) { <input asp-for="IdePro" type="hidden" /><div class="field"><label asp-for="IdePro"></label><input value="PRO-@Model.IdePro.ToString("D4")" readonly /></div> }
else { <div class="field"><label asp-for="IdePro"></label><input value="PRO-@((int)ViewBag.CodigoSiguiente).ToString("D4") · automático" readonly /></div> }
<div class="form-grid"><div class="field"><label asp-for="DesPro"></label><input asp-for="DesPro" placeholder="Ej. Cuaderno universitario" /><span asp-validation-for="DesPro"></span></div><div class="field"><label asp-for="FrePro"></label><input asp-for="FrePro" type="date" asp-format="{0:yyyy-MM-dd}" /><span asp-validation-for="FrePro"></span></div><div class="field"><label asp-for="CatPro"></label><select asp-for="CatPro" asp-items="ViewBag.Categorias"><option value="">Selecciona una categoría</option></select><span asp-validation-for="CatPro"></span></div><div class="field"><label asp-for="StoPro"></label><input asp-for="StoPro" type="number" min="1" max="1000" placeholder="De 1 a 1000" /><span asp-validation-for="StoPro"></span></div><div class="field"><label asp-for="PrePro"></label><input asp-for="PrePro" type="number" min="0.01" step="0.01" placeholder="0.00" /><span asp-validation-for="PrePro"></span></div></div>
<div class="form-actions"><button class="button" type="submit">@(editando ? "Guardar cambios" : "Registrar producto")</button><a class="button button-outline" asp-action="List">Cancelar</a></div></form></section>
