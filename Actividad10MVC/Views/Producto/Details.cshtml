@model Producto
@{ ViewData["Title"] = "Detalle de producto"; }
<div class="page-heading"><div><p class="eyebrow">MILIBRERÍA · PRODUCTO PRO-@Model.IdePro.ToString("D4")</p><h1>@Model.DesPro</h1></div><a class="button button-outline" asp-action="List">Volver al listado</a></div><section class="panel detail-panel"><dl><dt>IDE_PRO</dt><dd>PRO-@Model.IdePro.ToString("D4")</dd><dt>DES_PRO</dt><dd>@Model.DesPro</dd><dt>FRE_PRO</dt><dd>@Model.FrePro?.ToString("dd/MM/yyyy")</dd><dt>CAT_PRO</dt><dd>@Model.CatPro</dd><dt>STO_PRO</dt><dd>@Model.StoPro</dd><dt>PRE_PRO</dt><dd>@Model.PrePro?.ToString("C2")</dd></dl><div class="form-actions"><a class="button" asp-action="Edit" asp-route-id="@Model.IdePro">Editar producto</a><a class="button button-outline" asp-action="List">Cerrar</a></div></section>
