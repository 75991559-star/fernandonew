@model IEnumerable<Empleado>
@{
    ViewData["Title"] = "Empleados";
}
<div class="page-heading"><div><p class="eyebrow">CASO DESARROLLADO · DATASOFT</p><h1>Empleados</h1><p class="muted">Registra y administra los datos del personal.</p></div><a class="button" asp-action="Create">＋ Nuevo empleado</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert-success">@mensaje</div> }
<section class="panel">
    <form class="search-form" asp-action="List" method="get"><label for="q">Buscar por nombre o apellido</label><div><input id="q" name="q" value="@ViewBag.Busqueda" placeholder="Ej. María García" /><button class="button button-dark" type="submit">Buscar</button></div></form>
    <div class="table-wrap"><table><thead><tr><th>CODIGO</th><th>APELLIDOS</th><th>NOMBRES</th><th>FECHA NAC.</th><th>CATEGORIA</th><th>HIJOS</th><th>EMAIL</th><th>ACCIONES</th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td class="code-cell">EMP-@item.Codigo.ToString("D4")</td><td>@item.Apellidos</td><td>@item.Nombres</td><td>@item.FechaNacimiento?.ToString("dd/MM/yyyy")</td><td><span class="pill">@item.Categoria</span></td><td>@(item.Hijos?.ToString() ?? "—")</td><td>@(string.IsNullOrWhiteSpace(item.Correo) ? "—" : item.Correo)</td><td class="actions"><a asp-action="Details" asp-route-id="@item.Codigo">Ver</a><a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a><a class="danger-link" asp-action="Delete" asp-route-id="@item.Codigo">Eliminar</a></td></tr> }
    @if (!Model.Any()) { <tr><td colspan="8" class="empty-state">No hay empleados registrados todavía.</td></tr> }
    </tbody></table></div>
</section>
