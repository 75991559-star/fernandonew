@model Empleado
@{ ViewData["Title"] = "Eliminar empleado"; }
<div class="page-heading"><div><p class="eyebrow">DATASOFT · ELIMINAR REGISTRO</p><h1>Eliminar empleado</h1></div><a class="button button-outline" asp-action="List">Volver al listado</a></div>
<section class="panel confirm-panel"><div class="warning-icon">!</div><h2>¿Eliminar a @Model.Apellidos @Model.Nombres?</h2><p>Se quitará el registro EMP-@Model.Codigo.ToString("D4") de la colección.</p><form asp-action="Delete" asp-route-id="@Model.Codigo" method="post"><button class="button button-danger" type="submit">Sí, eliminar</button><a class="button button-outline" asp-action="List">Cancelar</a></form></section>
